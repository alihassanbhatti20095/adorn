# Copy to server/.env and fill in. Never commit .env.
PORT=4100
HOST=127.0.0.1

# Where enquiries are emailed (comma-separated allowed)
ENQUIRY_TO=sales@adorngroup.co.uk
# From address must be allowed by your SMTP provider
MAIL_FROM="Adorn Configurator <configurator@adorngroup.co.uk>"

# SMTP. Set MAIL_MODE=log to print emails instead of sending (testing).
MAIL_MODE=smtp
# Gmail/Workspace: smtp.gmail.com, and SMTP_PASS must be an App Password (not the account password).
# MAIL_FROM must then be the same Gmail address; Gmail rewrites any other sender.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public URL of the site (used for the "Open your configuration" link and the PDF QR code)
SITE_URL=https://configurator.adorngroup.co.uk

# Where enquiries are stored (JSON Lines). Relative to server/.
DATA_FILE=data/enquiries.jsonl

# Send the customer an automatic confirmation email (false to disable)
SEND_CONFIRMATION=true

# Abuse limit: enquiries per IP per hour
RATE_LIMIT_PER_HOUR=5
